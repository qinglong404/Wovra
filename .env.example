# 复制本文件为 .env 并填入真实配置（.env 不会被 git 提交）
Wovra_API_KEY=你的密钥
# OpenAI 协议兼容服务的地址，例如：
#   DeepSeek: https://api.deepseek.com/v1
#   火山方舟: https://ark.cn-beijing.volces.com/api/v3
Wovra_BASE_URL=https://api.example.com/v1
Wovra_MODEL=gpt-4o-mini

# 缓存命中计价折扣（等效输入换算）：DeepSeek ≈30，GLM-5.3-flash ≈3.5
# WOVRA_CACHE_RATE=3.478

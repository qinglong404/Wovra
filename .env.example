# 复制本文件为 .env 并填入真实配置（.env 不会被 git 提交）
Wovra_API_KEY=你的密钥
# OpenAI 协议兼容服务的地址，例如：
#   DeepSeek: https://api.deepseek.com/v1
#   火山方舟: https://ark.cn-beijing.volces.com/api/v3
Wovra_BASE_URL=https://api.example.com/v1
Wovra_MODEL=gpt-4o-mini

# 网页检索（web_search）走专业 API。配了就只走 API；没配则退回本地抓取
# （单通道、无相关性保证，结果里会标注"本地兜底"）。填哪几家都行——默认**随机**
# 挑一家先试，失败换下一家，全都不行才本地兜底（把调用摊到各家额度上）。
# 密钥请勿提交。
#   tavily    https://tavily.com/     （免费 1000 次/月）
#   serper    https://serper.dev/     （免费 2500 次）
#   exa       https://exa.ai/
#   bocha     https://open.bochaai.com/（博查，中文检索）
#   serpapi   https://serpapi.com/    （免费 250 次/月）
#   firecrawl https://firecrawl.dev/  （搜索 + 单页转 Markdown；它同时是 web_fetch 的兜底）
#   tinyfish  https://tinyfish.ai/     （**检索与抓取免费**；云浏览器自动化按步计费）
Wovra_Tavily=你的 Tavily 密钥
Wovra_Serper=你的 Serper 密钥
Wovra_Exa=你的 Exa 密钥
Wovra_Bocha=你的博查密钥
Wovra_SerpAPI=你的 SerpAPI 密钥
Wovra_Firecrawl=你的 Firecrawl 密钥
# TinyFish：Search（30 次/分）与 Fetch（150 URL/分）都**不扣余额**，只有云浏览器
# 自动化 web_automate 花钱（$0.016/步）。有了它，JS 渲染站的抓取走免费的 Fetch，
# 付费的 Firecrawl 只在它不可用时才轮到。
Wovra_TinyFish=你的 TinyFish 密钥
# 把某家钉在第一位（它挂了仍会往后轮）：tavily / serper / exa / bocha / serpapi / firecrawl
# Wovra_SEARCH_PROVIDER=bocha
# 此外也认通用的 Wovra_SEARCH_KEY（对每家都算配了）与各家惯用名
# TAVILY_API_KEY / SERPER_API_KEY / EXA_API_KEY / BOCHA_API_KEY / SERPAPI_API_KEY /
# FIRECRAWL_API_KEY。

# 缓存命中计价折扣（等效输入换算）——行业光谱 1/40 到 1/5：
#   OpenAI/Claude/Gemini/Kimi K3 ≈ 10（1/10）
#   GLM-5.3-Flash / Kimi K2.6 ≈ 3.5-5   DeepSeek ≈ 30（空闲）-15（高峰）
# WOVRA_CACHE_RATE=3.478

# 每轮一段话（V4 §3.2/§6.1）：**水位处攒批结算**——一批轮一次调用，产出一句话/轮 + 账本增量。
# 默认开（1）。关掉可省这次调用；开启后每次到水位多一次「指令 + 锚 + 产物」量级的调用。
# WOVRA_ROUND_NOTE=1
# 结算的硬上限（秒）：超时按失败处理、只留痕，不阻塞轮闭合。
# WOVRA_NOTE_TIMEOUT=180
# 单批最多写多少轮的产物：超了切几次调用（切出来的每次前缀仍在缓存里）。默认 12。
# WOVRA_NOTE_BATCH_MAX=12

# V4 上下文模型（默认开）：取消按域重组（所有 agent 共用同一份共享历史）；整理改为
# 就地演进（名字即身份，只增不重排）；分裂按活性文件画树。=0 退回旧链路（对照/回滚用）。
# WOVRA_V4=1
# 水位（token）：到线触发结算/分裂/折档。默认 100000。
# WOVRA_ORG_WATERMARK=100000
# 折档：把超龄轮的原文换成段落档（**只有水位触发**，轮号不参与）。
# 折到水位的这个比例以下（默认 0.6，一次折够 → 下次折档要等上下文长回来）。
# WOVRA_FOLD_TARGET=0.6
